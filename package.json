{
  "name": "opencode-remote-bash",
  "version": "0.1.0",
  "description": "OpenCode plugin: run bash commands on remote hosts over SSH ControlMaster multiplexing with a host-alias allowlist (remote_bash + remote_known_hosts tools).",
  "type": "module",
  "license": "MIT",
  "author": "Oscar Campbell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozra/opencode-remote-bash.git"
  },
  "homepage": "https://github.com/ozra/opencode-remote-bash",
  "bugs": {
    "url": "https://github.com/ozra/opencode-remote-bash/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ssh",
    "remote",
    "bash",
    "multiplexing"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.29",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  }
}
